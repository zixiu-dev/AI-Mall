DB_URL=jdbc:mysql://127.0.0.1:3307/bit_mall?characterEncoding=UTF-8&connectionTimeZone=%2B08:00&forceConnectionTimeZoneToSession=true
DB_USERNAME=bitmall
DB_PASSWORD=bitmall
AGENT_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_ENDPOINT_PATH=/v1/chat/completions
OPENAI_MODEL=gpt-4.1-mini
# Agent 备用模型。百炼控制台的兼容 base URL 以 /compatible-mode/v1 结尾。
AGENT_BAILIAN_ENABLED=false
AGENT_BAILIAN_API_KEY=
AGENT_BAILIAN_BASE_URL=
AGENT_BAILIAN_MODEL=qwen-plus
AGENT_MODEL_FAILURE_THRESHOLD=2
AGENT_MODEL_COOLDOWN=30s
AGENT_EXECUTION_DETAIL_QUEUE_CAPACITY=4096
AGENT_EXECUTION_DETAIL_RETENTION_DAYS=7


# Redis caches public catalog reads; checkout always revalidates in the database.
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DATABASE=0
CATALOG_CACHE_ENABLED=true
# 默认由 HotKey 识别后提升至 Caffeine；ALL/OFF 仅在明确需要全量本地缓存或独立对照时使用。
CATALOG_LOCAL_MODE=HOTKEY
CATALOG_CACHE_NAMESPACE=wowo:catalog:v1
HOTKEY_ENABLED=false
HOTKEY_APP_NAME=wowo-mall
HOTKEY_ETCD_SERVER=http://127.0.0.1:2379
MANAGEMENT_PORT=9080

# 普通配置默认启用；demo 配置默认关闭。应用不会自动加载本文件，需由启动环境导入。
ROCKETMQ_ENABLED=true
ROCKETMQ_NAME_SERVER=common-rocketmq-dev.magestack.cn:9876
ROCKETMQ_PRODUCER_GROUP=wowo_mall_order_producer_dev
ROCKETMQ_ORDER_TOPIC=wowo_mall_order_events_dev
ROCKETMQ_ORDER_CONSUMER_GROUP=wowo_mall_order_receipt_dev
ROCKETMQ_ACCESS_KEY=
ROCKETMQ_SECRET_KEY=

# 库存与锁使用独立 noeviction Redis，不能复用商品缓存的淘汰实例。
ORDER_REDIS_HOST=127.0.0.1
ORDER_REDIS_PORT=6381
ORDER_REDIS_PASSWORD=
ORDER_REDIS_DATABASE=0
ORDER_NAMESPACE=wowo:order:dev:
ORDER_LOCKS_ENABLED=true
# 模拟支付入口开关；不接入真实支付渠道。
ORDER_DEMO_PAYMENT_ENABLED=false
ROCKETMQ_SUBMIT_CONSUMER_GROUP=wowo_mall_order_create_dev

# 默认根据交易压力切换；AUTO 要求共享库存预扣，ASYNC/AUTO 需要启用 RocketMQ。
ORDER_SUBMISSION_MODE=AUTO
# 建单期限从异步受理时开始；支付期限从订单实际创建时开始。
ORDER_ASYNC_TIMEOUT_SECONDS=600
ROCKETMQ_BUILD_CONSUMER_GROUP=wowo_mall_order_build_dev
# 确认该建单组只对应本环境的数据库和交易 Redis 后开启。
ROCKETMQ_BUILD_DLQ_ENABLED=false

# 交易库存预扣使用独立 noeviction Redis；启用后不能未经排空核对直接关闭。
ORDER_INVENTORY_RESERVATION_ENABLED=true

# 单实例同步容量预算，需按本机压测和数据库容量调整。
ORDER_SYNC_QPS=60
CATALOG_BLOOM_ENABLED=true

# 新订单默认 15 分钟待支付；MQ 定时投递和扫描都以持久化截止时间为准。
ORDER_PAYMENT_TTL_SECONDS=900
ROCKETMQ_TIMEOUT_CONSUMER_GROUP=wowo_mall_order_timeout_dev

# RAG：主 Agent 仍使用上面的 OPENAI_*；embedding 可独立使用百炼。
RAG_MODE=KEYWORD
RAG_ENHANCEMENT_ENABLED=false
# 从百炼控制台复制与你的地域/工作空间匹配的 OpenAI 兼容 base URL（含 /v1）。
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_PATH=/embeddings
DASHSCOPE_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSION=1024
# 本地兼容性标签，模型/参数变更须改标签并重建；不是供应商承诺的固定模型修订。
RAG_EMBEDDING_VERSION=text-embedding-v4-config-1

# PostgreSQL + pgvector 独立于商城主库；LEGACY 仅兼容历史索引/测试。
RAG_VECTOR_STORE=PGVECTOR
RAG_PG_URL=jdbc:postgresql://127.0.0.1:5433/bitmall_knowledge
RAG_PG_USERNAME=bitmall
RAG_PG_PASSWORD=
RAG_PG_SEARCH_MODE=EXACT
